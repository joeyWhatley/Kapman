<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kapman.Game.Frame" editor-extension-mode="False">
    <Style src="../Frame.uss" />
    <!-- A PART OF THE FRAME that is made many times over. The code takes a copy of the element named "log-line" and fills in
         its words; a part inside it that is not wanted this time is taken out of the copy. Move, restyle or reorder
         the parts as you like, but keep their names. The element "preview" is only here so the part looks right in
         UI Builder (the frame's look hangs on the class frame-root): the game does not use it. -->
    <ui:VisualElement name="preview" class="frame-root" style="position: relative; width: 760px; height: 60px;">
        <!-- A LINE OF THE LOG: when (the part of the day, or the date of an older day), what happened in a few words,
             and at its right end the number that changed, signed (the code takes "figure" out where there is none). -->
        <ui:VisualElement name="log-line" class="frame-log-line">
            <ui:Label name="stamp" text="Morning" class="frame-log-stamp" />
            <ui:Label name="text" text="What happened" class="frame-log-text" />
            <ui:Label name="figure" text="-1 d" class="frame-log-figure" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
