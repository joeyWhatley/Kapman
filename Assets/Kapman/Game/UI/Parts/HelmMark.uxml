<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kapman.Game.Frame" editor-extension-mode="False">
    <Style src="../Frame.uss" />
    <!-- A PART OF THE FRAME (13 Oct 2026): THE HELM'S MARK, at the foot of the 3D view while it fills the screen. The code
         takes the element named "helm" and fills in whose hand is on the helm ("whose"), the keys ("keys"), and moves
         the "tiller" along the "track" as the helm is over (left: port; right: starboard). Restyle or reorder the parts
         as you like, but keep their names. The element "preview" is only here so the part looks right in UI Builder:
         the game does not use it. -->
    <ui:VisualElement name="preview" class="frame-root" style="position: relative; width: 420px; height: 90px; background-color: rgb(40, 28, 46);">
        <ui:VisualElement name="helm" class="frame-helm">
            <ui:Label name="whose" text="The steersman's hand" class="frame-helm-whose" />
            <ui:VisualElement name="track" class="frame-helm-track">
                <ui:VisualElement name="tiller" class="frame-helm-tiller" />
            </ui:VisualElement>
            <ui:Label name="keys" text="A  D  take the helm" class="frame-helm-keys" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
