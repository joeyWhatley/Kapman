<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- A PART OF THE NOTICES that is made many times over: ONE NOTICE, a line of plain fact in the panels' glass
         (black, see-through, a hard thin black line, square corners). The code (Notices.Show) takes a copy of the label
         named "notice", gives it its words and the notices' font, and fades it out after a few seconds. Restyle it
         here, but keep its name. The element "preview" is only here so the part looks right in UI Builder. -->
    <ui:VisualElement name="preview" style="position: relative; width: 640px; height: 60px; align-items: center; justify-content: center; background-color: rgb(120, 140, 150);">
        <ui:Label name="notice" text="The water casks are empty." picking-mode="Ignore" style="background-color: rgba(8, 9, 11, 0.6); color: rgb(232, 231, 226); font-size: 14px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); border-width: 1px; border-color: rgb(0, 0, 0); padding: 5px 12px; margin-bottom: 4px;" />
    </ui:VisualElement>
</ui:UXML>
