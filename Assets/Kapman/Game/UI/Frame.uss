}

.frame-root .frame-verb.off,
.frame-root .frame-verb.off:hover,
.frame-root .frame-verb.off:active {
    background-image: url("Xp/grain.png");
    background-color: rgb(158, 182, 150);
    border-top-color: rgb(136, 160, 132);
    border-left-color: rgb(136, 160, 132);
    border-right-color: rgb(136, 160, 132);
    border-bottom-color: rgb(136, 160, 132);
}

.frame-root .frame-float-shut,
.frame-root .frame-float-shut:hover {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    background-color: rgb(201, 85, 58);
    border-width: 2px;
    border-top-color: rgb(240, 150, 124);
    border-left-color: rgb(240, 150, 124);
    border-right-color: rgb(120, 40, 26);
    border-bottom-color: rgb(120, 40, 26);
}

.frame-root .frame-float-shut:hover {
    background-color: rgb(232, 123, 98);
}

/* ---- a row, a well, a picture: let into the ground */
.frame-root .frame-ln,
.frame-root .frame-ln-button,
.frame-root .frame-float-result,
.frame-root .frame-turn {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    border-width: 2px;
    border-top-color: rgb(110, 138, 110);
    border-left-color: rgb(110, 138, 110);
    border-right-color: rgb(232, 240, 222);
    border-bottom-color: rgb(232, 240, 222);
}

.frame-root .frame-log {
    border-top-color: rgb(92, 118, 92);
    border-left-color: rgb(92, 118, 92);
    border-right-color: rgb(224, 233, 212);
    border-bottom-color: rgb(224, 233, 212);
}

.frame-root .frame-face,
.frame-root .frame-float-face,
.frame-root .frame-ship-view {
    border-width: 2px;
    border-top-color: rgb(58, 18, 52);
    border-left-color: rgb(58, 18, 52);
    border-right-color: rgb(176, 104, 160);
    border-bottom-color: rgb(176, 104, 160);
}

/* ---- a window that floats: a slab of Byzantium, the one in front of gold */
.frame-root .frame-float {
    border-width: 4px;
    border-top-color: rgb(150, 76, 136);
    border-left-color: rgb(150, 76, 136);
    border-right-color: rgb(58, 18, 52);
    border-bottom-color: rgb(58, 18, 52);
}

.frame-root .frame-float.front {
    border-top-color: rgb(247, 227, 160);
    border-left-color: rgb(247, 227, 160);
    border-right-color: rgb(150, 104, 40);
    border-bottom-color: rgb(150, 104, 40);
}

.frame-root .frame-float-options,
.frame-root .frame-float-hint {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
}

.frame-root .frame-float-options {
    border-top-width: 2px;
    border-top-color: rgb(98, 124, 98);
}

/* ---- the world's own frame: a gold line inside the dark one, and a piece at each corner */
.frame-root .frame-viewport-line {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-color: rgb(184, 150, 70);
}

.frame-root .frame-corner {
    position: absolute;
    width: 42px;
    height: 42px;
    background-image: url("Xp/corner.png");
    background-repeat: no-repeat;
    background-size: 42px 42px;
}

.frame-root .frame-corner.tl {
    left: -4px;
    top: -4px;
}

.frame-root .frame-corner.tr {
    right: -4px;
    top: -4px;
    rotate: 90deg;
}

.frame-root .frame-corner.br {
    right: -4px;
    bottom: -4px;
    rotate: 180deg;
}

.frame-root .frame-corner.bl {
    left: -4px;
    bottom: -4px;
    rotate: 270deg;
}

/* ---- a name cut into its ground: a pale edge under each letter */
.frame-root .frame-slip .frame-h,
.frame-root .frame-win-name,
.frame-root .frame-who-name {
    text-shadow: 1px 1px 0 rgba(240, 246, 230, 0.75);
}

/* ---- the bar is one line at 1080p with the view buttons in it: its figures stand closer, its buttons are narrower,
   and no word of it breaks */
.frame-root .frame-top-figure {
    margin: 0 9px;
    flex-shrink: 0;
}

.frame-root .frame-top-figure Label,
.frame-root .frame-top-date,
.frame-root .frame-top-part {
    white-space: nowrap;
}

.frame-root .frame-top-date {
    margin-left: 12px;
}

.frame-root .frame-top .frame-k {
    padding: 1px 8px 2px 8px;
    margin-left: 4px;
}

.frame-root .frame-top .frame-k.frame-start {
    padding: 0 18px 0 14px;
    margin-left: 0;
}

.frame-root .frame-top-views {
    margin-right: 8px;
    padding-right: 8px;
}

/* ================================================================================================================
   WHAT IS SAID STANDS IN THE FOOT (the user, 7 Oct 2026, late: "why is he speaking twice, once in the middle and once
   at the bottom; expand the bottom one for more wide text space for characters, add their personality type / stats").
   A window of words (a card, a talk, an alert: FrameRoot.Floats.cs marks it "docked") is not in the middle of the
   world: it lies in the foot, over the portrait's place and the log, as wide as the two: a bar with its name; under it
   who speaks at the left (the face, who they are), the words in the middle, and the choices at the right when they
   come. Nothing stands under it ("you don't have to explain everything"): its last line is there only to say why a
   choice cannot be taken.
   ================================================================================================================ */
.frame-root .frame-float-body {
    flex-shrink: 1;
    min-height: 0;
}

.frame-root .frame-float-about {
    font-size: var(--t-quiet);
    color: var(--frame-mute);
    margin-top: 1px;
}

/* (it stands on the foot and is as tall as the foot when it has little to say; with many choices or a long word it
   grows upward over the world, to six tenths of the screen at most, and its words scroll after that) */
.frame-root .frame-float.docked {
    left: 24.6%;
    right: 17.8%;
    top: auto;
    bottom: 8px;
    width: auto;
    height: auto;
    min-height: 232px;
    max-height: 60%;
    translate: 0 0;
}

.frame-root.wide .frame-float.docked {
    left: 48%;
}

.frame-root .frame-float.docked .frame-float-bar {
    min-height: 32px;
}

.frame-root .frame-float.docked .frame-float-body {
    flex-direction: row;
    flex-grow: 1;
}

.frame-root .frame-float.docked .frame-float-top {
    flex-grow: 1;
    flex-basis: 0;
    padding: 8px 12px 6px 10px;
}

.frame-root .frame-float.docked .frame-float-face {
    width: 112px;
    height: 140px;
    margin-right: 14px;
}

.frame-root .frame-float.docked .frame-float-scroll,
.frame-root .frame-float.docked.paged .frame-float-scroll {
    min-height: 0;
    margin-top: 5px;
}

.frame-root .frame-float.docked .frame-float-options {
    width: 42%;
    flex-shrink: 0;
    justify-content: flex-start;
    border-top-width: 0;
    border-left-width: 2px;
    border-left-color: rgb(98, 124, 98);
}

.frame-root .frame-float.docked .frame-float-hint {
    position: absolute;
    left: 10px;
    bottom: 2px;
    padding: 0 8px;
}

.frame-root .frame-float.docked .frame-option {
    padding-top: 3px;
    padding-bottom: 3px;
}

/* ================================================================================================================
   THE THREE ROWS OF BUTTONS, THE PLACES, THE CHART'S TOOLS (the user, 7 Oct 2026, late; by the picker).
   The rack holds twelve buttons, four to a row (the ship; where she is; what is known): a little lower each than
   the eight were, so the windows under them keep their room. A place gone into (FramePlace) shows its picture in
   the world's frame, or its name on a plain ground until the user has sent one. The chart's own tools (Measure, and
   its four readings) stand in a small row on the boat's box, at the bottom right.
   ================================================================================================================ */
.frame-root .frame-verb {
    padding: 3px 2px 2px 2px;
    margin-bottom: 4px;
}

.frame-root .frame-place-ground {
    background-color: rgb(74, 28, 74);
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    color: rgb(226, 184, 198);
    -unity-font: url("project://database/Assets/HearthPixelFont/Hearth/Hearth.ttf");
    font-size: var(--t-title);
    -unity-text-align: middle-center;
}

.frame-root .frame-maptools {
    position: absolute;
    right: 16px;
    bottom: 244px;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-end;
}

.frame-root .frame-maptools .frame-tool {
    margin: 0 0 0 4px;
    padding: 1px 9px 2px 9px;
    width: auto;
}

.frame-root .frame-maptools .frame-verb.frame-tool {
    flex-direction: row;
    align-items: center;
}

.frame-root .frame-maptools .frame-verb.frame-tool .frame-icon {
    width: 18px;
    height: 18px;
    margin-right: 5px;
}

.frame-root .frame-book-find {
    margin: 2px 0 6px 0;
}

.frame-root .frame-book-find .unity-base-text-field__input {
    background-color: rgb(214, 221, 199);
    color: rgb(112, 41, 99);
    border-width: 2px;
    border-top-color: rgb(110, 138, 110);
    border-left-color: rgb(110, 138, 110);
    border-right-color: rgb(232, 240, 222);
    border-bottom-color: rgb(232, 240, 222);
    border-radius: 0;
    font-size: var(--t-body);
    padding: 1px 6px;
}

/* ---- the small box by the pointer on a linked word (WikiLinks, FrameRoot.Links.cs): the page's name, its kind, a brief word */
.frame-root .frame-link-box {
    position: absolute;
    width: 380px;
    padding: 7px 11px 8px 11px;
    background-color: rgb(214, 221, 199);
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    border-width: 2px;
    border-top-color: rgb(238, 244, 228);
    border-left-color: rgb(238, 244, 228);
    border-right-color: rgb(58, 18, 52);
    border-bottom-color: rgb(58, 18, 52);
}

.frame-root .frame-link-name {
    -unity-font: url("project://database/Assets/HearthPixelFont/Hearth/Hearth.ttf");
    font-size: var(--t-body);
    color: rgb(27, 94, 123);
}

.frame-root .frame-link-kind {
    font-size: var(--t-quiet);
    color: rgba(112, 41, 99, 0.8);
    margin-bottom: 3px;
}

.frame-root .frame-link-brief {
    font-size: var(--t-quiet);
    color: rgb(112, 41, 99);
    white-space: normal;
}

/* ---- the three faces, named here for the code to find (FrameFonts.cs): Hearth; the old face, drawn from for any
   letter Hearth has not (thorn, eth, the long vowels, Cyrillic); and the runes. Three unseen labels carry them. */
.font-probe {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
}

.font-probe-main {
    -unity-font: url("project://database/Assets/HearthPixelFont/Hearth/Hearth.ttf");
}

.font-probe-more {
    -unity-font: url("Fonts/DejaVuSansCondensed.ttf");
}

.font-probe-runes {
    -unity-font: url("Fonts/NotoSansRunic-Regular.ttf");
}

/* ---- the boat's caption in Hearth takes up to four rows (where she is, and the wind): her picture gives them the room */
.frame-root .frame-ship-view {
    height: 140px;
}

.frame-root .frame-ship-cap {
    padding: 3px 6px 0 6px;
}

.frame-root .frame-ship-wind {
    margin-left: 0;
}

/* ---- WHAT THE ONE WHO SPEAKS IS TALKING ABOUT (the user, 8 Oct 2026: "when Ravn is explaining what to do and how to
   play can you highlight what he is talking about"): a frame round it, a dark line outside and a gold one inside, with
   a breath of gold over the thing itself. FrameRoot moves it, sizes it and blinks it in steps (it is hidden until then). */
/* (THE GREEN, NOT GOLD: the user, 8 Oct 2026, "Ravn's highlighting needs to be that green tinge colour we had
   earlier": the 297036 of the name. The dark green line shows on the pale grounds, the pale one inside it on the purple
   bar, and the thing itself takes a green tinge.) */
.frame-root .frame-pointer {
    position: absolute;
    display: none;
    border-width: 4px;
    border-color: rgb(41, 112, 54);
    background-color: rgba(41, 112, 54, 0.2);
}

.frame-root .frame-pointer-line {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 3px;
    border-color: rgb(189, 214, 178);
}


/* ---- THE COIN, THE BARREL, AND THE SIGNS THAT ARE PICTURES (the user, 8 Oct 2026: "replace the word silver with a
   period accurate PNG of a coin", "replace the bread with a pic of a barrel ... and next to it 'supplies' or another
   word", "replace the button icons with wiki searched stuff"). The pictures are in the art folder (hud/hud.coin.png,
   hud.stores.png, hud.fn.NAME.png): the user's own in Art/final, or real things standing in (Design/art_standins.md). */
.frame-root .frame-top-picture {
    width: 36px;
    height: 36px;
    margin-right: 6px;
    flex-shrink: 0;
}

.frame-root .frame-top-figure #stores-word {
    margin-right: 8px;
}

/* a sign that is a picture: one colour of ink, tinted as the drawn signs are coloured */
.frame-root .frame-icon.pictured {
    width: 32px;
    height: 32px;
    -unity-background-image-tint-color: rgb(112, 41, 99);
}

.frame-root .frame-verb.on .frame-icon.pictured,
.frame-root .frame-verb:active .frame-icon.pictured {
    -unity-background-image-tint-color: rgb(240, 210, 122);
}

.frame-root .frame-verb.off .frame-icon.pictured {
    -unity-background-image-tint-color: rgba(112, 41, 99, 0.3);
}

.frame-root .frame-tool .frame-icon.pictured {
    width: 24px;
    height: 24px;
}
