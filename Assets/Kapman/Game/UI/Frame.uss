}

/* a window said one paragraph at a time keeps room for four rows, so that it does not jump at every paragraph */
.frame-root .frame-float.paged .frame-float-scroll {
    min-height: 128px;
}

/* ================================================================================================================
   THE TALL FOOT, AND TEXTURE AND DEPTH (the user, 7 Oct 2026, late).
   The layout, by the picker: nothing stands on the right; the portrait, the log and the boat's view stand side by
   side in one tall foot, and the world has the whole width over it. The buttons that change what is looked at
   (Chart or Port, Swap, Look) are in the top bar by the clock's ("a good addition, just not well placed").
   The dress: "can you texture the UI colour so it's not so sleek and glossy"; "the layout is good, it just needs more
   flair, more depth, more style". So no ground is smooth: each has a grain laid over it (Xp/grain.png: specks and
   scratches); a bar is lit from its top in dots (Xp/sheen.png), not in a smooth shade; a panel and a button stand up
   from their ground with a light edge up and to the left and a dark one down and to the right, and a row, a well and
   a picture are let into it the other way; a button pressed goes in. The world has a gold line and a piece at each
   corner (Xp/corner.png). The pictures are made by Bake/art/make_ui_textures.py.
   ================================================================================================================ */

/* ---- the layout */
.frame-root .frame-pane-foot {
    left: 24%;
    right: 0;
    bottom: 0;
    height: 248px;
}

.frame-root.wide .frame-pane-foot {
    left: 47.4%;
}

.frame-root .frame-viewport {
    right: 8px;
    bottom: 248px;
    border-width: 4px;
    border-color: rgb(30, 11, 33);
}

.frame-root .frame-port-view {
    left: 24%;
    top: 54px;
    right: 8px;
    bottom: 248px;
}

.frame-root.wide .frame-port-view {
    left: 47.4%;
}

.frame-root .frame-who {
    left: 24.6%;
    right: auto;
    top: auto;
    bottom: 8px;
    width: 17%;
    height: 232px;
    padding: 8px;
}

.frame-root.wide .frame-who {
    left: 48%;
    width: 13.2%;
}

.frame-root .frame-ship {
    right: 16px;
    bottom: 8px;
    width: 16.4%;
    height: 232px;
    padding: 4px;
}

.frame-root .frame-ship-view {
    height: 170px;
}

.frame-root .frame-log {
    left: 42%;
    right: 17.8%;
    bottom: 8px;
    height: 232px;
}

.frame-root.wide .frame-log {
    left: 61.6%;
}

/* ---- the top bar: its three groups, the view buttons, and the clock's word hung under its right end */
.frame-root .frame-top-left,
.frame-root .frame-top-right {
    flex-shrink: 0;
    flex-wrap: nowrap;
}

.frame-root .frame-top-mid {
    flex-shrink: 1;
    flex-wrap: nowrap;
    overflow: hidden;
}

.frame-root .frame-top-views {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    padding-right: 12px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.4);
}

.frame-root .frame-top-views .frame-k {
    padding: 1px 9px 2px 9px;
    margin-left: 4px;
}

.frame-root .frame-top-state {
    position: absolute;
    right: 0;
    top: 52px;
    min-width: 0;
    margin-left: 0;
    padding: 1px 10px 2px 10px;
    color: rgb(255, 255, 255);
    background-color: rgb(112, 41, 99);
    border-width: 2px;
    border-top-color: rgb(176, 104, 160);
    border-left-color: rgb(176, 104, 160);
    border-right-color: rgb(58, 18, 52);
    border-bottom-color: rgb(58, 18, 52);
}

/* ---- a ground: grain over its colour, and standing up from what it lies on */
.frame-root .frame-slip,
.frame-root .frame-rack {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    background-position-x: left;
    background-position-y: top;
    border-width: 2px;
    border-top-color: rgb(224, 233, 212);
    border-left-color: rgb(224, 233, 212);
    border-right-color: rgb(92, 118, 92);
    border-bottom-color: rgb(92, 118, 92);
}

.frame-root .frame-pane {
    background-color: rgb(104, 38, 92);
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    background-position-x: left;
    background-position-y: top;
}

.frame-root .frame-pane-foot {
    background-color: rgb(98, 35, 87);
    background-image: url("Xp/grain.png");
}

/* ---- a bar: lit from its top in dots, a gold rule under the one across the screen */
.frame-root .frame-top,
.frame-root .frame-float-bar {
    background-color: rgb(112, 41, 99);
    background-image: url("Xp/sheen.png");
    background-repeat: repeat-x;
    background-size: 16px 64px;
    background-position-x: left;
    background-position-y: top;
}

.frame-root .frame-top {
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(184, 150, 70);
}

.frame-root .frame-win-head {
    background-color: rgb(176, 196, 166);
    background-image: url("Xp/sheen.png");
    background-repeat: repeat-x;
    background-size: 16px 64px;
    background-position-x: left;
    background-position-y: top;
    border-bottom-width: 2px;
    border-bottom-color: rgb(112, 41, 99);
}

/* ---- a button: it stands up; under the pointer it turns pale gold; pressed, or on, it goes in */
.frame-root .frame-k,
.frame-root .frame-verb,
.frame-root .frame-pick,
.frame-root .frame-tab {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    border-width: 2px;
    border-top-color: rgb(238, 244, 228);
    border-left-color: rgb(238, 244, 228);
    border-right-color: rgb(86, 112, 88);
    border-bottom-color: rgb(86, 112, 88);
}

.frame-root .frame-tab {
    border-bottom-width: 0;
}

.frame-root .frame-k:hover,
.frame-root .frame-verb:hover,
.frame-root .frame-pick:hover,
.frame-root .frame-ln-button:hover {
    background-image: url("Xp/grain.png");
    background-color: rgb(250, 236, 190);
}

.frame-root .frame-k:active,
.frame-root .frame-verb:active,
.frame-root .frame-verb.on,
.frame-root .frame-pick.on {
    background-image: url("Xp/grain.png");
    background-color: rgb(112, 41, 99);
    border-top-color: rgb(58, 18, 52);
    border-left-color: rgb(58, 18, 52);
    border-right-color: rgb(176, 104, 160);
    border-bottom-color: rgb(176, 104, 160);
}

.frame-root .frame-k.on,
.frame-root .frame-wm.on {
    background-image: url("Xp/grain.png");
    background-repeat: repeat;
    background-size: 128px 128px;
    background-color: rgb(240, 210, 122);
    border-width: 2px;
    border-top-color: rgb(150, 104, 40);
    border-left-color: rgb(150, 104, 40);
    border-right-color: rgb(252, 238, 188);
    border-bottom-color: rgb(252, 238, 188);
}

.frame-root .frame-k.go,
.frame-root .frame-k.go:hover {
    background-image: url("Xp/grain.png");
    border-top-color: rgb(176, 104, 160);
    border-left-color: rgb(176, 104, 160);
    border-right-color: rgb(58, 18, 52);
    border-bottom-color: rgb(58, 18, 52);
}

.frame-root .frame-k.frame-start {
    background-image: url("Xp/grain.png");
    background-color: rgb(240, 210, 122);
    border-width: 2px;
    border-top-color: rgb(252, 238, 188);
    border-left-color: rgb(252, 238, 188);
    border-right-color: rgb(150, 104, 40);
    border-bottom-color: rgb(150, 104, 40);
}

.frame-root .frame-k.frame-start:hover {
