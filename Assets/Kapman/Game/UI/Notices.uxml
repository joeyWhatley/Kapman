<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- THE NOTICES' LAYOUT (KAPMAN_PLAN step 2d, 14 Oct 2026): the Source Asset of the Notices' UI Document. Plain
         facts as they happen stand at the top of the screen for a few seconds, each a copy of Parts/Notice.uxml put
         into the element named "notices" (Code/Game/UI/Notices.cs). Move or restyle the holder here, but keep its
         name; the code moves it down under the chart's top bar while the chart is open. -->
    <ui:VisualElement name="notices" picking-mode="Ignore" style="position: absolute; top: 14px; left: 0; right: 0; align-items: center;" />
</ui:UXML>
