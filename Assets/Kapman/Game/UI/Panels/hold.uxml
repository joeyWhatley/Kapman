<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kapman.Game.Frame" editor-extension-mode="False">
    <Style src="../Frame.uss" />
    <!-- THE HOLD WINDOW'S OWN LAYOUT (KAPMAN_PLAN step 2d, 14 Oct 2026): a copy of the element "panel" is put into the
         side window's body, and the panel's code (Code/Game/UI/Frame/Panels/HoldPanel.cs) puts its lines into the
         named sections below. Move, reorder or restyle the sections as you like, but keep their names: a section
         gone from the file gets its lines in the body's end. The element "preview" is only here so the part looks
         right in UI Builder: the game does not use it. -->
    <ui:VisualElement name="preview" class="frame-root" style="position: relative; width: 440px; height: 420px;">
        <ui:VisualElement name="panel" class="frame-panel">
            <!-- the room taken -->
            <ui:VisualElement name="room" class="frame-section" />
            <!-- each good aboard, one line a good -->
            <ui:VisualElement name="goods" class="frame-section" />
            <!-- the room left -->
            <ui:VisualElement name="room-left" class="frame-section" />
            <!-- the crew's stores as days -->
            <ui:VisualElement name="stores" class="frame-section" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
