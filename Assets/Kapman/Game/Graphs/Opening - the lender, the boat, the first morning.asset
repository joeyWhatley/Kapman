  m_Name: Opening - the lender, the boat, the first morning
  m_EditorClassIdentifier: Unity.VisualScripting.Flow::Unity.VisualScripting.ScriptGraphAsset
  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Opening - the lender, the boat, the first morning","summary":"What follows the title when a new game begins, part by part, left to right. Each node is a part of the show (Code/Game/UI/Showtime.cs).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"a8e63e96-7d47-445f-97e2-646d740820f3","$version":"A","$type":"Kapman.Graphs.OnOpening","$id":"9"},{"defaultValues":{},"position":{"x":320.0,"y":0.0},"guid":"b4d9a36a-5ea2-4f54-b4cc-988317583838","$version":"A","$type":"Kapman.Graphs.OpeningBoxComesUp","$id":"11"},{"defaultValues":{},"position":{"x":620.0,"y":0.0},"guid":"f4db50bc-2998-45a3-9305-73112df9e436","$version":"A","$type":"Kapman.Graphs.OpeningWhoAreYou","$id":"13"},{"defaultValues":{},"position":{"x":920.0,"y":0.0},"guid":"b8a37ae4-597c-4c61-ae83-8a0914388632","$version":"A","$type":"Kapman.Graphs.OpeningGameBegins","$id":"15"},{"defaultValues":{},"position":{"x":1220.0,"y":0.0},"guid":"3a033cc0-bf17-4ca1-b83f-ca0539a1ec65","$version":"A","$type":"Kapman.Graphs.OpeningLenderSpeaks","$id":"17"},{"defaultValues":{},"position":{"x":1520.0,"y":0.0},"guid":"2b6eca11-0111-454a-8e88-f2594e0e6e2e","$version":"A","$type":"Kapman.Graphs.OpeningTheShowroom","$id":"19"},{"defaultValues":{},"position":{"x":1820.0,"y":0.0},"guid":"924a7ec5-2b77-48f4-b1a1-83426587d2ed","$version":"A","$type":"Kapman.Graphs.OpeningTheFirstMorning","$id":"21"},{"defaultValues":{},"position":{"x":2120.0,"y":0.0},"guid":"13b7e87f-0c71-47ac-8001-c35c670d0604","$version":"A","$type":"Kapman.Graphs.OpeningWaitForTheFirstClick","$id":"23"},{"defaultValues":{},"position":{"x":2420.0,"y":0.0},"guid":"5a982a0d-1bb8-4e3f-98b0-569ec5fff949","$version":"A","$type":"Kapman.Graphs.OpeningTheMarks","$id":"25"},{"defaultValues":{},"position":{"x":2720.0,"y":0.0},"guid":"fca019b8-04b6-40a8-bdd8-ef05889cbb0c","$version":"A","$type":"Kapman.Graphs.OpeningRavnSpeaks","$id":"27"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"11"},"destinationKey":"enter","guid":"edd65464-5d84-4cf3-a516-e3bc85ea5da3","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"exit","destinationUnit":{"$ref":"13"},"destinationKey":"enter","guid":"b513d085-f043-49d2-9615-ab1d9f8ab08a","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"13"},"sourceKey":"exit","destinationUnit":{"$ref":"15"},"destinationKey":"enter","guid":"90821c76-cd00-4e25-a537-3256c453963d","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"exit","destinationUnit":{"$ref":"17"},"destinationKey":"enter","guid":"1f037319-e499-4e32-81c0-2390a64e5458","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"exit","destinationUnit":{"$ref":"19"},"destinationKey":"enter","guid":"ea542022-b34b-44b0-a289-3fb59904b3c7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"exit","destinationUnit":{"$ref":"21"},"destinationKey":"enter","guid":"3a573ff8-d8fc-4fbb-8bd0-c1dc2a7291c3","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"exit","destinationUnit":{"$ref":"23"},"destinationKey":"enter","guid":"0f165338-9d4c-4f0c-a3a6-15e726a9a3b5","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"23"},"sourceKey":"exit","destinationUnit":{"$ref":"25"},"destinationKey":"enter","guid":"7bf2f642-3563-44b5-ae3a-a90fec2396e9","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"25"},"sourceKey":"exit","destinationUnit":{"$ref":"27"},"destinationKey":"enter","guid":"9fcbd55e-9ebb-4af6-b5a9-ece877108556","$type":"Unity.VisualScripting.ControlConnection"},{"position":{"xMin":-40.0,"yMin":-90.0,"xMax":3040.0,"yMax":240.0},"label":"A new game begins","comment":"The box comes up; who are you; the game begins as answered; the lender speaks; the showroom; the first morning; the first click; the marks; Ravn.","color":{"r":0.62,"g":0.45,"b":0.22,"a":1.0},"guid":"3539d171-9239-4a49-bff9-a4c364b8ad63","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":270.0,"xMax":600.0,"yMax":460.0},"title":"How it hangs together","body":"''The box comes up'' takes the game in hand: the clock is held and the keys are the show''s. ''The first morning'' gives it back and arms the next click. ''Wait for the first click'' and ''The marks'' go together. Leave those in; any other part can be left out, or others put between them.","colorTheme":"Classic","guid":"cbe06841-571b-437e-ac5e-7714e5f5ccd5","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":640.0,"yMin":270.0,"xMax":1260.0,"yMax":460.0},"title":"Put things between","body":"A wait (Time > Wait For Seconds), a sound, a line of your own (Kapman > Text), a check on what was answered: join it between two parts. The words themselves are in Showtime.cs for now (AskFirst, LenderLines, PlateLines, Ravn''s lines): placeholders for the user''s own.","colorTheme":"Classic","guid":"97c784c3-d36a-46b8-9f8b-264edfa21758","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":1300.0,"yMin":270.0,"xMax":1920.0,"yMax":460.0},"title":"What comes before","body":"The slow start and the title (the loader, the sea, the name, the menu) are still in Showtime.cs (SlowStart, TitleNow, LeaveTitle). This graph starts when a new game is chosen there, or from the menu in a game.","colorTheme":"Classic","guid":"cc4e3111-1163-4ecc-8502-fc2149e4cf4b","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
