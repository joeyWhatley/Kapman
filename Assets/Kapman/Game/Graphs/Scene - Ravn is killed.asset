  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Scene - Ravn is killed","summary":"The lender''s men have killed Ravn and their card is shut: his scene, part by part and line by line, left to right. Each node is a part of the show (Code/Game/UI/Showtime.cs); the words of each line are in the writing, by the line''s key.","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"ec45d999-7f90-4b02-a82e-2c9d26ec758e","$version":"A","$type":"Kapman.Graphs.OnRavnIsKilled","$id":"9"},{"defaultValues":{},"position":{"x":300.0,"y":0.0},"guid":"3acadb70-c95f-4107-8269-09c2679dab37","$version":"A","$type":"Kapman.Graphs.SceneThePurpleComesUp","$id":"11"},{"defaultValues":{"who":{"$content":"brute","$type":"System.String"},"key":{"$content":"feud.scene.1","$type":"System.String"},"breaksOff":{"$content":false,"$type":"System.Boolean"}},"position":{"x":640.0,"y":0.0},"guid":"d021f95d-e678-4245-9cb3-f4f71963ed95","$version":"A","$type":"Kapman.Graphs.SceneSayALine","$id":"13"},{"defaultValues":{"who":{"$content":"man","$type":"System.String"},"key":{"$content":"feud.scene.2","$type":"System.String"},"breaksOff":{"$content":false,"$type":"System.Boolean"}},"position":{"x":980.0,"y":0.0},"guid":"73707cb3-8758-406b-8112-1f68303ffa7d","$version":"A","$type":"Kapman.Graphs.SceneSayALine","$id":"15"},{"defaultValues":{"who":{"$content":"ravn","$type":"System.String"},"key":{"$content":"feud.scene.3","$type":"System.String"},"breaksOff":{"$content":true,"$type":"System.Boolean"}},"position":{"x":1320.0,"y":0.0},"guid":"dca2c606-7541-465d-949b-ae4463d67edb","$version":"A","$type":"Kapman.Graphs.SceneSayALine","$id":"17"},{"defaultValues":{},"position":{"x":1660.0,"y":0.0},"guid":"b7cbc434-6801-4892-828a-d9320f071056","$version":"A","$type":"Ka