4d95-8642-2e1380f1ba67","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"exit","destinationUnit":{"$ref":"19"},"destinationKey":"enter","guid":"736c9a64-0dc3-42ae-a01a-91b443ec673c","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"exit","destinationUnit":{"$ref":"21"},"destinationKey":"enter","guid":"15c61963-8181-4d10-8e38-1b0888b6ecf8","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"exit","destinationUnit":{"$ref":"23"},"destinationKey":"enter","guid":"a5a851fd-ae35-4f6d-be82-bddcf6333893","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"23"},"sourceKey":"exit","destinationUnit":{"$ref":"25"},"destinationKey":"enter","guid":"14a66a07-3843-4677-a31f-c562e406c0a9","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"25"},"sourceKey":"exit","destinationUnit":{"$ref":"27"},"destinationKey":"enter","guid":"3d1bec6c-61f8-4b43-bf02-8e26af6f2972","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"27"},"sourceKey":"exit","destinationUnit":{"$ref":"29"},"destinationKey":"enter","guid":"be6faccc-1c3b-487c-9c1c-eb3d402630d1","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"29"},"sourceKey":"exit","destinationUnit":{"$ref":"31"},"destinationKey":"enter","guid":"a14e374d-4728-41d9-afa8-6ed9b5b99212","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"31"},"sourceKey":"exit","destinationUnit":{"$ref":"33"},"destinationKey":"enter","guid":"5372fdd5-3326-4ea3-8c86-7fa3dd8025ce","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"33"},"sourceKey":"exit","destinationUnit":{"$ref":"35"},"destinationKey":"enter","guid":"a8af4afc-e195-4370-92d6-264da4b715dc","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"35"},"sourceKey":"exit","destinationUnit":{"$ref":"37"},"destinationKey":"enter","guid":"f3518f3c-37b0-4768-bb0e-413396e67479","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"37"},"sourceKey":"exit","destinationUnit":{"$ref":"39"},"destinationKey":"enter","guid":"0e9c247a-b461-4810-8899-e809aa2f831e","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"39"},"sourceKey":"exit","destinationUnit":{"$ref":"41"},"destinationKey":"enter","guid":"4ca81d99-b7c9-4d47-8942-a26213ce77b7","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"plate","destinationUnit":{"$ref":"37"},"destinationKey":"small","guid":"d90c3b34-cf6d-44a5-9845-f42ae14daff3","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-90.0,"xMax":3720.0,"yMax":270.0},"label":"1. They come the third time","comment":"The purple comes up; the lender''s men say what they have come for; Ravn begins a riddle and is cut off; the screen is struck, and the teller says what was done.","color":{"r":0.62,"g":0.45,"b":0.22,"a":1.0},"guid":"47889fac-fa1b-4b6f-87d2-e69cd66f98da","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-40.0,"yMin":330.0,"xMax":3720.0,"yMax":690.0},"label":"2. After the knife","comment":"Those who are left speak; his name and where he died; the purple lifts on the game; and what follows: she stands over him.","color":{"r":0.62,"g":0.45,"b":0.22,"a":1.0},"guid":"d1ae1abd-e3ea-4a6a-a173-061132abcfab","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":730.0,"xMax":600.0,"yMax":940.0},"title":"How it hangs together","body":"''The purple comes up'' takes the game in hand: the clock is held and the keys are the show''s. ''The purple lifts'' gives it back. Leave those two in (a scene left standing with nothing running is lifted by the show itself after a while, and the Console says so). ''What follows his death'' asks her what is to be done: left out, it follows by itself a moment later.","colorTheme":"Classic","guid":"d4956fc9-7f45-44f7-ad6e-e3e254284f6e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":640.0,"yMin":730.0,"xMax":1260.0,"yMax":940.0},"title":"The lines","body":"Each ''say a line'' has WHO speaks (one of the scene''s cast: brute, man, ravn, aldger; nothing for the teller, who has no face) and the KEY of its words. The words are in Game/Data/writing/wokerer.json (feud.scene.1 ...): placeholders for the user''s own. At sea the words of the key with .sea after it stand in, where they are written. ''Breaks off'': said to its last letter, and nobody is waited for.","colorTheme":"Classic","guid":"74ef648e-2009-4cc4-8159-56dbe8be2dc1","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":1300.0,"yMin":730.0,"xMax":1920.0,"yMax":940.0},"title":"The hit","body":"''The screen is struck'' is the red filter and the shaken picture, in hard steps: two flashes and no more (three or more in a second is what harms some eyes). The line after it comes whole at once, under the red. Move it before another line, or take it out.","colorTheme":"Classic","guid":"e34ba0a9-1442-4063-8a19-d9b63005de5e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":1960.0,"yMin":730.0,"xMax":2580.0,"yMax":940.0},"title":"Put things between; and without this graph","body":"A wait (Time > Wait For Seconds), a sound, a line of your own: join it between two parts. Where no graph listens for his death (a batch run, a scene without this machine) the same parts are run from code, staged by the table (Game/Data/feud_rules_793.json, \"scene\"): keep the two alike.","colorTheme":"Classic","guid":"ae44529b-8276-493c-bbcc-f751065b7925","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
