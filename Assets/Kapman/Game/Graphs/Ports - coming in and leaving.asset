43"},"destinationKey":"condition","guid":"3ef5a693-d62c-440f-b143-99ca1fd54838","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"47"},"sourceKey":"output","destinationUnit":{"$ref":"45"},"destinationKey":"input","guid":"1a8a2467-6405-4052-ab73-f61b96848679","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-60.0,"xMax":1460.0,"yMax":460.0},"label":"1. The ship coming in to a port","comment":"Every frame: if she isn''t lying anywhere, is inside a port''s reach, has slowed, and isn''t just leaving, she''s arrived.","color":{"r":0.25,"g":0.42,"b":0.62,"a":1.0},"guid":"8bce0010-5bbb-4ed6-9f43-11556f370f94","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":1460.0,"yMin":-60.0,"xMax":2440.0,"yMax":300.0},"label":"2. Arrived: lie to and open the port","comment":"Remember the port, stop the ship, and open the menu (Ports - in port).","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"fdb4e7bf-327f-438e-9bab-7734317e9ea5","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-40.0,"yMin":640.0,"xMax":1060.0,"yMax":940.0},"label":"3. Out of the harbour again","comment":"Once she''s outside every port''s reach she''s no longer ''leaving'', and can come in somewhere again.","color":{"r":0.25,"g":0.42,"b":0.62,"a":1.0},"guid":"3a5cef2e-087c-4357-ad57-370e0a377e7c","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":460.0,"xMax":400.0,"yMax":610.0},"title":"Tune it here","body":"1.5 on the Less node: how slow (m/s) she must be to count as arrived (0.5 m/s is a knot).\nEach port''s reach is on its Port component (Arrival Radius, game metres round its Berth).","colorTheme":"Classic","guid":"27c3a9b1-bb6c-4dd0-8587-00ac10ca2c4a","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
