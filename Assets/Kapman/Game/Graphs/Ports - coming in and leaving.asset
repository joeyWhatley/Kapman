  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Ports - coming in and leaving","summary":"Watches the ship: when she''s slowed inside a port''s reach she lies to at its berth and the port''s menu opens. When she casts off she''s ''leaving'' till she''s out of the harbour again.","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":false,"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"27ca5301-93e8-42ef-8c06-2b84d059f8bb","$version":"A","$type":"Unity.VisualScripting.Update","$id":"9"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Docked port","$type":"System.String"},"object":null},"position":{"x":0.0,"y":180.0},"guid":"d22a9839-afdd-4ac8-9712-b7be485f6c93","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"11"},{"defaultValues":{},"position":{"x":260.0,"y":0.0},"guid":"d0c73c05-ad59-4f7d-8afc-e34ca051f053","$version":"A","$type":"Unity.VisualScripting.NullCheck","$id":"13"},{"defaultValues":{},"position":{"x":260.0,"y":220.0},"guid":"a6d230c9-e5d7-4f78-b0f6-3c2b4b201c6d","$version":"A","$type":"Kapman.Graphs.PortNearestToShip","$id":"15"},{"defaultValues":{},"position":{"x":260.0,"y":360.0},"guid":"60bb223c-9f2c-44f2-8d53-33112743ac75","$version":"A","$type":"Kapman.Graphs.ShipSpeed","$id":"17"},{"numeric":true,"defaultValues":{"b":{"$content":1.5,"$type":"System.Single"}},"position":{"x":520.0,"y":340.0},"guid":"e19bdd07-ee55-4aec-97dc-ea56a3a7ab8c","$version":"A","$type":"Unity.VisualScripting.Less","$id":"19"},{"specifyFallback":false,"kind":"Object","defaultValues":{"name":{"$content":"Leaving","$type":"System.String"},"object":null},"position":{"x":520.0,"y":200.0},"guid":"ba75bbf6-d2a7-4f01-b8fb-25d9d240a8a6","$version":"A","$type":"Unity.VisualScripting.GetVariable","$id":"21"},{"defaultValues":{},"position":{"x":720