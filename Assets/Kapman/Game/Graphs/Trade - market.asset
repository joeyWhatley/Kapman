  m_Name: Trade - market
  m_EditorClassIdentifier: Unity.VisualScripting.Flow::Unity.VisualScripting.ScriptGraphAsset
  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Trade - market","summary":"Every deal in a market comes here as ''On trade'' (the market itself opens in the town view: Town - explore the town).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":false,"defaultValues":{},"position":{"x":0.0,"y":440.0},"guid":"c48c6a8d-05d0-416e-b1a2-63e619e05858","$version":"A","$type":"Kapman.Graphs.OnTrade"},{"position":{"xMin":-40.0,"yMin":380.0,"xMax":1260.0,"yMax":800.0},"label":"2. After each deal","comment":"''On trade'' fires for every buy and sale: what, how many, for how much, where, and the law on the good. Reputation (slaving, arms, relics...) and events will hook in here.","color":{"r":0.25,"g":0.42,"b":0.62,"a":1.0},"guid":"3934b764-cab4-4439-8c81-6a239f612a4f","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":-40.0,"xMax":620.0,"yMax":160.0},"title":"How the market works","body":"Prices: Game/Data/goods_793.json (each good''s value, and where it''s made and wanted) and Game/Data/trade_rules.json (money, tolls, laws, how prices answer supply and demand).\nThe panel: Code/Game/UI/MarketPanel.cs. The rules: Code/Game/Trade. The market node (Market: Open) can also open it over the 3D, without the map.","colorTheme":"Classic","guid":"f5b11897-88ff-460f-ac3e-dbac1f967043","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":300.0,"yMin":440.0,"xMax":820.0,"yMax":660.0},"title":"Hook things on here","body":"e.g. law = ''captives'' and not bought -> standing with the Church''s people falls (Reputation, to come).\ne.g. law = ''arms'' bought in a Frankish port -> a chance of the count''s men searching her as she leaves.","colorTheme":"Classic","guid":"4be31ebd-7189-4283-91bb-22d4ff72cc76","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
