-aefb-4364-9a35-30732e3e1bfc","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"104"},"sourceKey":"trigger","destinationUnit":{"$ref":"106"},"destinationKey":"enter","guid":"12789bc3-1676-4fa7-b559-5050b605c02a","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"paidLately","destinationUnit":{"$ref":"11"},"destinationKey":"condition","guid":"c47c8ce7-f6d4-4ba9-8987-9fcfe3cad9c2","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"answer","destinationUnit":{"$ref":"23"},"destinationKey":"selector","guid":"8cffe0a9-5d74-4065-a6d6-1dfb682cae57","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"trick","destinationUnit":{"$ref":"70"},"destinationKey":"trick","guid":"2dd9ea31-e928-47e4-b483-2669f2f6f81c","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"angry","destinationUnit":{"$ref":"76"},"destinationKey":"angry","guid":"01937f4e-43f8-41e6-9573-642b6a01b8d6","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"76"},"sourceKey":"does","destinationUnit":{"$ref":"78"},"destinationKey":"selector","guid":"679beec3-4ffd-4931-94b8-535367934daa","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"76"},"sourceKey":"does","destinationUnit":{"$ref":"89"},"destinationKey":"selector","guid":"d4f2e684-7c21-4eaf-b146-977ebf5dffd7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"87"},"sourceKey":"gotNothing","destinationUnit":{"$ref":"98"},"destinationKey":"condition","guid":"7c348536-df44-4ce4-8185-ec2c0203f5e3","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-90.0,"xMax":1460.0,"yMax":310.0},"label":"1. The lender''s day to send comes","comment":"Four times in the life of the debt. If she has paid a pound or more on the stick since the last time, he has had something of his own and sends nobody; else a boat of his men sets out.","color":{"r":0.25,"g":0.42,"b":0.62,"a":1.0},"guid":"c7e7437f-45e1-42e9-8fb4-9e024e714944","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-40.0,"yMin":330.0,"xMax":1460.0,"yMax":630.0},"label":"2. They catch her","comment":"Made fast at a quay they have come to, or alongside at sea after a chase. Their card comes: the quay''s (harbour.goons.quay) or the sea''s (sea.goons.alongside).","color":{"r":0.62,"g":0.45,"b":0.22,"a":1.0},"guid":"3360ee83-94f0-417e-8cfc-36ed75418444","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-40.0,"yMin":710.0,"xMax":4700.0,"yMax":2880.0},"label":"3. She answers them","comment":"What each answer does, a row to an answer. The lender cools when she pays and is the angrier when they come home with nothing or fooled; a way round them is counted, and is harder the next time.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"9c23d301-f594-457f-a2de-1a0a15ef4465","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":760.0,"yMin":2230.0,"xMax":4680.0,"yMax":2790.0},"label":"4. Given nothing, what they do depends","comment":"On the lender''s temper, on what there is aboard to take, on whether she has just made fools of them, and on how often she has paid nothing (the two rule graphs). They only talk; or take; or take and beat a man; or take and kill one; and the third time she pays nothing, it is Ravn.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"5882c073-3765-4a70-bd2d-9fa9d0cb4d30","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-40.0,"yMin":2920.0,"xMax":1460.0,"yMax":3220.0},"label":"5. They give up","comment":"Their days are out, or no quay knows where she is, or they were sent the wrong way and have found it out. They go home with nothing (that is theirs), and the lender is the angrier.","color":{"r":0.25,"g":0.42,"b":0.62,"a":1.0},"guid":"d0b0c683-d1b0-4583-be54-e29acf751d56","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":1000.0,"yMin":-40.0,"xMax":1420.0,"yMax":220.0},"title":"The days","body":"The days they set out, how many men, and how many days they stay out are the table''s (collectors_793.json, \"sendings\"). \"Lately\" is a pound on the stick (paidLatelyD) since the last sending or the last time she paid them.","colorTheme":"Classic","guid":"0090076d-0dbe-44bb-8eae-b83d8d9d79de","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":760.0,"yMin":380.0,"xMax":1420.0,"yMax":560.0},"title":"Their card","body":"What they say and what she can answer is the card''s (Game/Data/encounters/wokerer_793.json; the words in Game/Data/writing/wokerer.json). Each answer ends in one of the answers of section 3. Take this part out and they stand by her and say nothing.","colorTheme":"Classic","guid":"6a0a2514-54ac-4026-8972-4636ba60c05f","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":800.0,"yMin":2570.0,"xMax":1560.0,"yMax":2760.0},"title":"The two rules","body":"What they come for is \"Rule - what the lender''s men come for\" (an instalment, more as his temper climbs). What they do is \"Rule - what the lender''s men do\": 0 they only talk, 1 they take, 2 and beat a man, 3 and kill a man, 4 and kill Ravn. Both are in Game/Graphs/Rules. Ravn''s death then has a scene of its own: the graph \"Scene - Ravn is killed\".","colorTheme":"Classic","guid":"c27d151c-090c-46b4-855d-e2edb6dda20f","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":0.0,"yMin":960.0,"xMax":380.0,"yMax":1290.0},"title":"The answers","body":"paid: a pound on the stick.\npaid_well: two pounds or more.\ndone: all of it.\ncargo: cargo for an instalment.\nastray: the lie worked.\ndrunk: the drink worked.\npoured: the drink was wasted.\nshaken: she ran, at sea.\nrouted: she killed the one who killed Ravn.\nfooled: another way round them worked.\nnothing: she gives them nothing.","colorTheme":"Classic","guid":"d7f9d104-a799-4f47-ba42-8b579cb1a6ba","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":0.0,"yMin":1320.0,"xMax":380.0,"yMax":1570.0},"title":"What is said","body":"What a part has to say of what happened (\"They carry off two casks of wine ...\") is put into the card''s end, in the order the parts run. PLACEHOLDER WORDS, in Collectors.cs: the user''s to write.","colorTheme":"Classic","guid":"7bf09448-3eeb-4f6c-bcb8-2475d803c9a8","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
