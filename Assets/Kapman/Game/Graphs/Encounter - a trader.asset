  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Encounter - a trader","summary":"A trader made out at sea (the lookout: Code/Game/Sim/SeaWatch.cs) can be met: hold your course, or close and hail her. She heaves to, your ship makes for her and lies to alongside; the game''s clock stands still while you talk (the sea keeps moving). Then you part, she sails on and your course resumes. Facts only: your writing for each key goes in Game/Data/writing.json.","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"f0d6c9bf-652e-4e1c-9821-4fd0ddc46aca","$version":"A","$type":"Kapman.Graphs.OnShipMadeOut","$id":"9"},{"defaultValues":{},"position":{"x":260.0,"y":0.0},"guid":"8268af9c-b5af-44d6-8d18-a7be72ff4ce0","$version":"A","$type":"Unity.VisualScripting.If","$id":"11"},{"defaultValues":{"ship":{"$content":-1,"$type":"System.Int32"}},"position":{"x":480.0,"y":0.0},"guid":"f3b666c8-1100-45d7-b976-ed6a73e80bca","$version":"A","$type":"Kapman.Graphs.EncounterOffer","$id":"13"},{"defaultValues":{"key":{"$content":"encounter.trader","$type":"System.String"},"title":{"$content":"","$type":"System.String"},"intention":{"$content":"","$type":"System.String"},"frost":{"$content":false,"$type":"System.Boolean"}},"position":{"x":720.0,"y":0.0},"guid":"d4e19cf8-e5c1-496e-81e1-8f83797d8c23","$version":"A","$type":"Kapman.Graphs.TextShow","$id":"15"},{"defaultValues":{"key":{"$content":"encounter.hold","$type":"System.String"},"intention":{"$content":"Hold your course","$type":"System.String"}},"position":{"x":960.0,"y":0.0},"guid":"f53596bb-2a3e-469e-9384-bc1e4106f7ac","$version":"A","$type":"Kapman.Graphs.TextAddOption","$id":"17"},{"defaultValues":{"key":{"$content":"encounter.hail","$type":"System.String"},"intention":{"$content":"Close an