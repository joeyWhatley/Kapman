  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Rule - the crew''s pay for a day","summary":"What is added each day to what the crew is owed. The game asks this graph once a game day (GameRules.DayPay, from Voyage.Day).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"365157d9-a767-45a9-903f-9471e8121529","$version":"A","$type":"Kapman.Graphs.PayRule","$id":"9"},{"defaultValues":{},"position":{"x":380.0,"y":120.0},"guid":"a40bf12c-4051-4075-937e-9e6a89f4118a","$version":"A","$type":"Unity.VisualScripting.GenericMultiply","$id":"11"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"}},"position":{"x":700.0,"y":0.0},"guid":"14e4a25e-1df9-47aa-b932-9ba95bce1d9c","$version":"A","$type":"Kapman.Graphs.RuleAnswer","$id":"13"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"13"},"destinationKey":"enter","guid":"2e295d16-6aea-4ccc-9b13-e2eccd541095","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"men","destinationUnit":{"$ref":"11"},"destinationKey":"a","guid":"f3d806ee-b38c-4b1c-bfc3-5e94a03f9e49","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"payAMan","destinationUnit":{"$ref":"11"},"destinationKey":"b","guid":"35649696-4d58-49c9-8533-240f82053c7e","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"product","destinationUnit":{"$ref":"13"},"destinationKey":"number","guid":"ec12238e-ad44-43f4-9e1a-1b37d6b6e508","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":1060.0,"yMax":340.0},"label":"The crew''s pay for a day","comment":"The men aboard, times a man''s pay for a day.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"29cd1a37-99e3-4b6d-9f31-9eb3e48b59ce","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":220.0,"xMax":500.0,"yMax":350.0},"title":"Where the numbers come from","body":"A man''s pay a day: ''pay'' in Game/Data/voyage_rules.json. They are paid what is owed when she next lies in a port; a man owed too long goes ashore for good (Voyage.InPort).","colorTheme":"Classic","guid":"1608be65-b2ab-40ce-a840-a0a43b91d7a5","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":540.0,"yMin":220.0,"xMax":1020.0,"yMax":350.0},"title":"Change it here","body":"A steersman''s share, more for a long voyage, less for a boy: put it between the two nodes. The test RuleGraphTests holds this graph to the plain sum until it is changed on purpose.","colorTheme":"Classic","guid":"329e00e4-dd2b-4460-b69e-87bb3eb2c67b","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
