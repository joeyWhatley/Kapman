  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Rule - does the steersman lay her course again when the helm is given back","summary":"Your hand has left the helm (H, or the swap back to the chart). Does the steersman lay her course again from where she is, or does she lie to? The game asks this graph the moment the helm is given back (GameRules.LaysAgainOnGiveBack, from HandHelm).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"b5d71f2e-46d4-4a69-8d01-9705768d091f","$version":"A","$type":"Kapman.Graphs.GiveBackRule","$id":"9"},{"how":"AtLeast","defaultValues":{"a":{"$content":0.0,"$type":"System.Double"},"b":{"$content":0.5,"$type":"System.Double"}},"position":{"x":680.0,"y":20.0},"guid":"1d114f8d-b3d2-4166-959d-5fb03d4a1804","$version":"A","$type":"Kapman.Graphs.IsIt","$id":"11"},{"how":"AtLeast","defaultValues":{"a":{"$content":0.0,"$type":"System.Double"},"b":{"$content":0.5,"$type":"System.Double"}},"position":{"x":680.0,"y":200.0},"guid":"92ee724b-ade2-41a3-abbf-6b7e274e11ec","$version":"A","$type":"Kapman.Graphs.IsIt","$id":"13"},{"how":"FirstAndNotSecond","defaultValues":{"one":{"$content":false,"$type":"System.Boolean"},"other":{"$content":false,"$type":"System.Boolean"}},"position":{"x":1000.0,"y":100.0},"guid":"3272d2f3-16b3-4cf0-9e45-fa7bb3c77df9","$version":"A","$type":"Kapman.Graphs.BothOrEither","$id":"15"},{"defaultValues":{"when":{"$content":false,"$type":"System.Boolean"},"yes":{"$content":1.0,"$type":"System.Double"},"no":{"$content":0.0,"$type":"System.Double"}},"position":{"x":1440.0,"y":100.0},"guid":"408360a2-e5a9-4917-90e8-1152ba21679a","$version":"A","$type":"Kapman.Graphs.ThisOrThat","$id":"17"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"}},"position":{"x":1760.0,"y":0.0},"guid":"1