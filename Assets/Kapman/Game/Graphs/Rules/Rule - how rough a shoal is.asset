Scripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":1860.0,"yMax":380.0},"label":"How rough a shoal is","comment":"Its own roughness, by the wind (from 4 m/s, all of it at 13), and by the tide: 0.7 of it at slack water, all of it with the stream at its hardest.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"79e29e51-44e0-41b4-a541-eb097b0f4249","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":260.0,"xMax":440.0,"yMax":370.0},"title":"Where the numbers come from","body":"The water''s own roughness is in Game/Data/rough_waters_793.json. The shares on the nodes are this rule''s own: change them here.","colorTheme":"Classic","guid":"5051ccfe-4695-422d-93a7-dbe91b444d26","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
