  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Rule - what he keeps of his error along a coast","summary":"Along a coast the land tells the steersman a share of his error each hour. The answer is the share he still has after the step (1: all of it). The game asks this graph each minute she coasts by reckoning (GameRules.ErrorKept, from Adrift.SteersBy).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"f7491cff-4a14-49a3-946f-5d9873a1403a","$version":"A","$type":"Kapman.Graphs.ErrorKeptRule","$id":"9"},{"defaultValues":{"when":{"$content":false,"$type":"System.Boolean"},"yes":{"$content":0.0,"$type":"System.Double"},"no":{"$content":0.0,"$type":"System.Double"}},"position":{"x":480.0,"y":160.0},"guid":"dcf12432-00ba-49c3-938b-b5b7d7b3d413","$version":"A","$type":"Kapman.Graphs.ThisOrThat","$id":"11"},{"defaultValues":{"when":{"$content":false,"$type":"System.Boolean"},"yes":{"$content":0.0,"$type":"System.Double"},"no":{"$content":0.0,"$type":"System.Double"}},"position":{"x":780.0,"y":120.0},"guid":"2f54e956-f94f-4110-8d3a-d5a5e6b87d32","$version":"A","$type":"Kapman.Graphs.ThisOrThat","$id":"13"},{"defaultValues":{"rate":{"$content":0.0,"$type":"System.Double"},"hours":{"$content":1.0,"$type":"System.Double"}},"position":{"x":1080.0,"y":80.0},"guid":"300a1610-0c12-4604-b8d2-5c626d205dcf","$version":"A","$type":"Kapman.Graphs.WhatIsLeftAfter","$id":"15"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"}},"position":{"x":1400.0,"y":0.0},"guid":"bcd5fda4-f623-43f6-a890-62091225bd3f","$version":"A","$type":"Kapman.Graphs.RuleAnswer","$id":"17"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"17"},"destinationKey":"enter","guid":"b8fefbbe-a332-413d-bf3d-0caea7574594","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"night","destinationUnit":{"$ref":"11"},"destinationKey":"when","guid":"3457b37d-0de7-4f45-9c4d-f98f0bf6072e","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"eyeNight","destinationUnit":{"$ref":"11"},"destinationKey":"yes","guid":"34aafeb2-1e11-4f3f-8f58-cb2a4ac5810f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"eyeDay","destinationUnit":{"$ref":"11"},"destinationKey":"no","guid":"adede534-80ed-401f-9be6-ef15cc7e09c7","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"thick","destinationUnit":{"$ref":"13"},"destinationKey":"when","guid":"238e8e0b-dc88-4844-80f7-c4d55b632753","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"picked","destinationUnit":{"$ref":"13"},"destinationKey":"no","guid":"6bfcfc8d-7e85-48d8-b6c4-0cafaae173a1","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"13"},"sourceKey":"picked","destinationUnit":{"$ref":"15"},"destinationKey":"rate","guid":"f6e4adab-f8a3-489c-adf1-281aa91f9cb2","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"hours","destinationUnit":{"$ref":"15"},"destinationKey":"hours","guid":"21a4791b-b6af-4659-bb23-79ea7e80574a","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"left","destinationUnit":{"$ref":"17"},"destinationKey":"number","guid":"3dd84a29-8b65-49ab-ae07-4eb0d8e731b7","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":1760.0,"yMax":420.0},"label":"What he keeps of his error along a coast","comment":"By day the land tells him so much of it an hour, by night less, in thick fog nothing. On the open sea he is told nothing at all (this is not asked there).","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"381d918c-b6ef-442f-a312-2572c6fdae3e","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":320.0,"xMax":460.0,"yMax":410.0},"title":"Where the numbers come from","body":"coastEye and coastEyeNight in Game/Data/sea_push.json.","colorTheme":"Classic","guid":"7fce1583-dc67-4ba1-a8f3-314a91b3a7d1","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
