nationUnit":{"$ref":"17"},"destinationKey":"amount","guid":"ff6eb9ab-0c65-4b51-8de0-b49c8e68292f","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"sum","destinationUnit":{"$ref":"19"},"destinationKey":"to","guid":"a5a2b241-08af-4eb9-81f1-8a735bbb4351","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"forWeapons","destinationUnit":{"$ref":"19"},"destinationKey":"amount","guid":"da20cb33-4d73-4b42-8dc9-85eaa57832e5","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"weapons","destinationUnit":{"$ref":"19"},"destinationKey":"when","guid":"40da9b1f-61e2-4a9f-9271-3a79640f4ada","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"sum","destinationUnit":{"$ref":"21"},"destinationKey":"to","guid":"eba5e318-88b9-4325-b833-e5290f89f1af","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"place","destinationUnit":{"$ref":"21"},"destinationKey":"amount","guid":"b0453c48-493e-4de8-93df-0658ca27f22e","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"21"},"sourceKey":"sum","destinationUnit":{"$ref":"23"},"destinationKey":"number","guid":"02747a89-64da-455a-a23f-061f3de9130a","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":2260.0,"yMax":440.0},"label":"How a fight stands","comment":"Her nerve; then so much for each man she has more than they, or fewer (three either way at the most); then so much for weapons aboard; then what the place costs her.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"3375e19a-d4a7-48d9-ba8e-37fff5ac5367","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":330.0,"xMax":600.0,"yMax":440.0},"title":"Where the numbers come from","body":"fightPerMan, fightWeapons, fightDoor and lenderHard in Game/Data/feud_rules_793.json. Her nerve is the stat as it stands, marks and all. Their men: the boat that is out, or the men in the lender''s yard.","colorTheme":"Classic","guid":"f6ec6118-68b2-4aab-9d28-77b38350caed","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":640.0,"yMin":330.0,"xMax":1260.0,"yMax":440.0},"title":"What the answer does","body":"A card''s chance takes it as its \"by\": each point over 3 adds a twentieth to the card''s own odds, each point under 3 takes one off. The odds themselves are in the cards (encounters/wokerer_793.json).","colorTheme":"Classic","guid":"719549ee-eb09-4c73-9912-0f058bcece3d","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
