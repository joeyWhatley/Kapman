  m_Name: Rule - the toll on a sale
  m_EditorClassIdentifier: Unity.VisualScripting.Flow::Unity.VisualScripting.ScriptGraphAsset
  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Rule - the toll on a sale","summary":"What the toll takes when the merchant sells. The game asks this graph each time (GameRules.Toll); the world''s other ships go by the same sum in code.","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"54eb84e3-9232-40b7-a5c4-7520ffb8625f","$version":"A","$type":"Kapman.Graphs.TollRule","$id":"9"},{"defaultValues":{},"position":{"x":380.0,"y":150.0},"guid":"fa8b9b14-baef-4ca8-a916-cf41cb48c2a4","$version":"A","$type":"Unity.VisualScripting.GenericMultiply","$id":"11"},{"defaultValues":{},"position":{"x":620.0,"y":200.0},"guid":"8bf1760e-1616-4446-bd3e-2461ded4e7ff","$version":"A","$type":"Unity.VisualScripting.GenericMultiply","$id":"13"},{"defaultValues":{"sum":{"$content":0.0,"$type":"System.Double"}},"position":{"x":860.0,"y":200.0},"guid":"bccd8fa6-c0a6-4eb0-8465-235b08a2e0a1","$version":"A","$type":"Kapman.Graphs.RoundToHundredth","$id":"15"},{"defaultValues":{},"position":{"x":1100.0,"y":120.0},"guid":"02027e8f-6c44-4508-bcf7-ed36633beb1a","$version":"A","$type":"Unity.VisualScripting.SelectUnit","$id":"17"},{"type":"System.Double","value":{"$content":0.0,"$type":"System.Double"},"defaultValues":{},"position":{"x":900.0,"y":90.0},"guid":"39e52028-0cea-4d44-a58f-94a462c127f4","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"19"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"}},"position":{"x":1360.0,"y":0.0},"guid":"47033f5a-9e99-497f-ac12-386885a1510a","$version":"A","$type":"Kapman.Graphs.RuleAnswer","$id":"21"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"21"},"destinationKey":"enter","guid":"d9d8e733-5591-4f91-b6dc-90460bdfe59e","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"soldFor","destinationUnit":{"$ref":"11"},"destinationKey":"a","guid":"85a2f73d-6f2a-4627-9e91-f7b1512426ff","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"share","destinationUnit":{"$ref":"11"},"destinationKey":"b","guid":"7db89364-d7f1-4b33-9a23-5f5b6a431ac2","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"product","destinationUnit":{"$ref":"13"},"destinationKey":"a","guid":"7dedded8-5cac-412f-a92b-b000aa606272","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"factor","destinationUnit":{"$ref":"13"},"destinationKey":"b","guid":"7b87f17c-adfd-4524-955d-37dd3e226398","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"13"},"sourceKey":"product","destinationUnit":{"$ref":"15"},"destinationKey":"sum","guid":"ad26b522-a681-46ac-a599-2597545c5817","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"free","destinationUnit":{"$ref":"17"},"destinationKey":"condition","guid":"cf355c2a-8b04-46f8-9b19-640c346be2e4","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"output","destinationUnit":{"$ref":"17"},"destinationKey":"ifTrue","guid":"d8aa3782-8184-43cb-9434-b6d1b08ae77d","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"rounded","destinationUnit":{"$ref":"17"},"destinationKey":"ifFalse","guid":"e7fcf296-603c-43f3-8daa-cc26870e908b","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"selection","destinationUnit":{"$ref":"21"},"destinationKey":"number","guid":"dc139670-3819-4b23-a480-5f7873dbe868","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":1600.0,"yMax":480.0},"label":"The toll on what the merchant sells","comment":"Sold for, times the toll''s share, times what it is multiplied by here and now, to the hundredth of a denier. Free of toll here: nothing.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"366fc6ec-8023-4345-b6c0-2ba59c936280","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":300.0,"xMax":500.0,"yMax":470.0},"title":"Where the numbers come from","body":"The toll''s share: each zone''s ''toll'' in Game/Data/trade_rules.json (0.1 is a tenth).\nTimes, here and now: 1 as a rule; a toll man bought off or crossed changes it for a while (the cards).\nFree of toll here: a charter won in the chest (Chest.TollFreeAt).","colorTheme":"Classic","guid":"65025f3a-e68e-4d7f-9c7b-289dfc1e0915","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":540.0,"yMin":300.0,"xMax":1100.0,"yMax":470.0},"title":"Change it here","body":"This graph is the merchant''s rule. Put a node between ''To the hundredth'' and the answer and his toll changes (a flat fee added, a ceiling, a kinder toll for a known man...). The world''s other ships keep to the plain sum in code (GameRules.TollByCode), and a test holds this graph to that sum until it is changed on purpose (RuleGraphTests).","colorTheme":"Classic","guid":"fa333c3d-af83-4866-9fd6-d507521579be","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
    _objectReferences: []
