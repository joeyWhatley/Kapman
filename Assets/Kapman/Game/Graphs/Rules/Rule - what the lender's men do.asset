","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"69"},"sourceKey":"picked","destinationUnit":{"$ref":"71"},"destinationKey":"number","guid":"bff52162-cae1-4585-8f31-40e7cfbc75d5","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-100.0,"xMax":3860.0,"yMax":1160.0},"label":"What the lender''s men do when they are given nothing","comment":"It depends (the user, 9 Oct 2026: \"Dependant\", \"It''ll be dynamic you know\"): on the lender''s temper, on what there is aboard to take, on whether she has just made fools of them, and on how often she has paid nothing.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"19eb77ee-2887-483c-b07e-1013006e70fb","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":2900.0,"yMin":760.0,"xMax":3780.0,"yMax":1020.0},"title":"The answer","body":"0  they only talk, and go home.\n1  they take what they came for: silver first, then cargo for the rest.\n2  they take, and beat a man.\n3  they take, and kill a man.\n4  they take, and kill Ravn.\nWhat they take is another rule (Rule - what the lender''s men come for).","colorTheme":"Classic","guid":"6abdcd2a-f4ae-42b9-bed0-52a812121bfc","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-20.0,"yMin":1000.0,"xMax":440.0,"yMax":1130.0},"title":"Where the numbers come from","body":"warnUpTo, beatFrom, killFrom, killEarly and ravnAtRefusal in Game/Data/collectors_793.json. The throw is the game''s own, one for each sending.","colorTheme":"Classic","guid":"591f89fc-efd7-4940-bc94-b9c48f7d0149","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
