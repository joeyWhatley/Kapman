  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Rule - how rough an open cape is","summary":"How rough the water off a cape with no shelter is now, from 0 (quiet) to its own roughness: a steep confused sea in a fresh wind. The game asks this graph each minute she is in one (GameRules.RoughCape, from RoughWaters.Roughness).","pan":{"x":0.0,"y":0.0},"zoom":1.0,"elements":[{"defaultValues":{},"position":{"x":0.0,"y":0.0},"guid":"ec29c3f8-d312-454d-9da2-935636273f6b","$version":"A","$type":"Kapman.Graphs.RoughCapeRule","$id":"9"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"},"from":{"$content":5.0,"$type":"System.Double"},"upTo":{"$content":14.0,"$type":"System.Double"}},"position":{"x":520.0,"y":100.0},"guid":"5465d25f-0f1f-4af0-9b06-3d225e3e014a","$version":"A","$type":"Kapman.Graphs.ShareBetween","$id":"11"},{"defaultValues":{"a":{"$content":0.0,"$type":"System.Double"},"b":{"$content":1.0,"$type":"System.Double"}},"position":{"x":820.0,"y":40.0},"guid":"07438e76-2228-495a-90a2-2c36be7cdca8","$version":"A","$type":"Kapman.Graphs.Times","$id":"13"},{"defaultValues":{"a":{"$content":0.4,"$type":"System.Double"},"b":{"$content":1.0,"$type":"System.Double"}},"position":{"x":520.0,"y":260.0},"guid":"cced7e86-7f6a-44d2-b430-e78dbb64106e","$version":"A","$type":"Kapman.Graphs.Times","$id":"15"},{"defaultValues":{"to":{"$content":0.6,"$type":"System.Double"},"amount":{"$content":0.0,"$type":"System.Double"},"when":{"$content":true,"$type":"System.Boolean"}},"position":{"x":820.0,"y":240.0},"guid":"e9e0820c-b469-4716-9449-f2267c8344a1","$version":"A","$type":"Kapman.Graphs.AddIf","$id":"17"},{"defaultValues":{"a":{"$content":0.0,"$type":"System.Double"},"b":{"$content":1.0,"$type":"System.Double"}},"position":{"x":1120.0,"y":120.0},"guid":"27c855c8-188c-4c24-9785-aaaf4e993152","$version":"A","$type":"Kapman.Graphs.Times","$id":"19"},{"defaultValues":{"number":{"$content":0.0,"$type":"System.Double"}},"position":{"x":1420.0,"y":0.0},"guid":"16fbb623-a25f-4328-bb28-37ffb91666fb","$version":"A","$type":"Kapman.Graphs.RuleAnswer","$id":"21"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"21"},"destinationKey":"enter","guid":"597a57e3-14d5-4031-9d4c-f6cd0e1cce4a","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"wind","destinationUnit":{"$ref":"11"},"destinationKey":"number","guid":"f493f745-004d-4c23-afe4-dbc7eb76c113","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"rough","destinationUnit":{"$ref":"13"},"destinationKey":"a","guid":"36475750-86c9-4f7c-b0e6-020a89cfbb4a","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"11"},"sourceKey":"share","destinationUnit":{"$ref":"13"},"destinationKey":"b","guid":"ab44df9e-065e-4e13-af04-fced5057459b","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"9"},"sourceKey":"run","destinationUnit":{"$ref":"15"},"destinationKey":"b","guid":"a79db88a-02c0-4a5e-86c2-749ee9e5b4be","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"product","destinationUnit":{"$ref":"17"},"destinationKey":"amount","guid":"84e7d0ce-1ab3-46a4-8fbf-ff2da19af87e","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"13"},"sourceKey":"product","destinationUnit":{"$ref":"19"},"destinationKey":"a","guid":"29ff23f3-c49a-4208-8535-76db1d251d6a","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"sum","destinationUnit":{"$ref":"19"},"destinationKey":"b","guid":"a3242b77-88b5-42e6-a0bd-928eb8979b66","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"product","destinationUnit":{"$ref":"21"},"destinationKey":"number","guid":"24c5f935-1ac0-4b82-a764-01bf41d1e159","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":-40.0,"yMin":-80.0,"xMax":1860.0,"yMax":380.0},"label":"How rough an open cape is","comment":"Its own roughness, by the wind (from 5 m/s, all of it at 14), and by the tide: 0.6 of it at slack water, all of it with the stream at its hardest.","color":{"r":0.32,"g":0.55,"b":0.32,"a":1.0},"guid":"f8eb0840-9191-4966-bd76-d1ea0d943333","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":-20.0,"yMin":260.0,"xMax":440.0,"yMax":370.0},"title":"Where the numbers come from","body":"The water''s own roughness is in Game/Data/rough_waters_793.json. The shares on the nodes are this rule''s own: change them here.","colorTheme":"Classic","guid":"d70a05ef-5021-4ec4-b62c-d7d79ce210ce","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
